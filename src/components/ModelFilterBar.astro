---
interface Props {
  vendors: string[];
  total: number;
}
const { vendors, total } = Astro.props;
---

<form class="filter-bar" data-model-filter role="search">
  <input
    class="input filter-search"
    type="search"
    name="q"
    placeholder="Cari model atau vendor…"
    aria-label="Cari model"
    data-filter-q
  />
  <select class="input" name="vendor" aria-label="Filter vendor" data-filter-vendor>
    <option value="">Semua vendor</option>
    {vendors.map((v) => <option value={v}>{v}</option>)}
  </select>
  <select class="input" name="tier" aria-label="Filter tier" data-filter-tier>
    <option value="">Semua tier</option>
    <option value="free">Free</option>
    <option value="premium">Premium</option>
  </select>
  <select class="input" name="sort" aria-label="Urutkan" data-filter-sort>
    <option value="name">Nama (A–Z)</option>
    <option value="ctx">Konteks terbesar</option>
    <option value="vendor">Vendor</option>
  </select>
  <span class="filter-count" data-filter-count>{total} model</span>
</form>
