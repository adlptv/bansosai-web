---
// Typewriter: mengetik frasa bergantian dengan kursor berkedip.
// Menghormati prefers-reduced-motion — saat reduced, teks statis ditampilkan
// tanpa animasi.
interface Props {
  phrases: string[];
  class?: string;
}
const { phrases, class: className } = Astro.props;
const first = phrases[0] ?? '';
---

<span class={`typewriter ${className ?? ''}`.trim()} data-typewriter data-phrases={JSON.stringify(phrases)}>
  <span data-typewriter-text>{first}</span><span class="typewriter-caret" data-typewriter-caret>&nbsp;</span>
</span>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
    if (reduce) return;
    const text = el.querySelector<HTMLElement>('[data-typewriter-text]');
    if (!text) return;
    let phrases: string[] = [];
    try {
      phrases = JSON.parse(el.dataset.phrases ?? '[]') as string[];
    } catch {
      phrases = [];
    }
    if (phrases.length < 2) return;

    let phraseIdx = 0;
    let charIdx = phrases[0]?.length ?? 0;
    let deleting = false;

    const tick = () => {
      const current = phrases[phraseIdx] ?? '';
      if (!deleting) {
        charIdx += 1;
        text.textContent = current.slice(0, charIdx);
        if (charIdx >= current.length) {
          deleting = true;
          window.setTimeout(tick, 1600);
          return;
        }
        window.setTimeout(tick, 60);
      } else {
        charIdx -= 1;
        text.textContent = current.slice(0, Math.max(0, charIdx));
        if (charIdx <= 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          window.setTimeout(tick, 300);
          return;
        }
        window.setTimeout(tick, 30);
      }
    };
    window.setTimeout(tick, 1600);
  });
</script>
