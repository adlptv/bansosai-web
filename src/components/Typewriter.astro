---
// Typewriter: mengetik frasa bergantian dengan kursor berkedip.
//
// Menghormati prefers-reduced-motion — saat reduced, frasa pertama ditampilkan
// statis tanpa animasi.
//
// SSR mengisi frasa pertama supaya tidak ada layout shift dan tetap terbaca
// bila JS gagal; script hanya menggantinya saat animasi benar-benar berjalan.
interface Props {
  phrases: string[];
  class?: string;
}
const { phrases, class: className } = Astro.props;
const first = phrases[0] ?? '';
---

<span class={`typewriter ${className ?? ''}`.trim()} data-typewriter data-phrases={JSON.stringify(phrases)}>
  <span data-typewriter-text>{first}</span><span class="typewriter-caret" data-typewriter-caret aria-hidden="true"></span>
</span>

<script>
  // Idempotent init: aman dijalankan berulang (mis. setelah view transition).
  function initTypewriters() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-typewriter]').forEach((el) => {
      if (el.dataset.typewriterReady === '1') return;
      el.dataset.typewriterReady = '1';

      const text = el.querySelector<HTMLElement>('[data-typewriter-text]');
      if (!text) return;

      let phrases: string[] = [];
      try {
        const raw = el.getAttribute('data-phrases') ?? '[]';
        phrases = JSON.parse(raw) as string[];
      } catch {
        phrases = [];
      }
      if (!Array.isArray(phrases) || phrases.length < 2) return;

      // Reduced motion (atau preferensi mati): biarkan frasa pertama statis.
      if (reduce) return;

      const TYPE_MS = 70;
      const DELETE_MS = 35;
      const HOLD_MS = 1400;
      const GAP_MS = 260;

      let phraseIdx = 0;
      let charIdx = 0;
      let deleting = false;

      // Mulai dari kosong supaya animasi terlihat sejak kunjungan pertama.
      text.textContent = '';

      const tick = () => {
        const current = phrases[phraseIdx] ?? '';
        if (!deleting) {
          charIdx += 1;
          text.textContent = current.slice(0, charIdx);
          if (charIdx >= current.length) {
            deleting = true;
            window.setTimeout(tick, HOLD_MS);
            return;
          }
          window.setTimeout(tick, TYPE_MS);
        } else {
          charIdx -= 1;
          text.textContent = current.slice(0, Math.max(0, charIdx));
          if (charIdx <= 0) {
            deleting = false;
            phraseIdx = (phraseIdx + 1) % phrases.length;
            window.setTimeout(tick, GAP_MS);
            return;
          }
          window.setTimeout(tick, DELETE_MS);
        }
      };

      // Delay kecil agar halaman selesai paint sebelum mengetik.
      window.setTimeout(tick, 400);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTypewriters, { once: true });
  } else {
    initTypewriters();
  }
</script>
