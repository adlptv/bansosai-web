---
import Button from './Button.astro';
import Typewriter from './Typewriter.astro';
import HeroDots from './HeroDots.astro';

// Nama pembuat model (vendor), bukan id model — mis. "Claude" bukan
// "claude-sonnet-4". Diganti bergantian oleh animasi typewriter.
const phrases = ['Claude', 'DeepSeek', 'GLM', 'Gemini', 'Qwen', 'Kimi', 'Grok', 'Mistral', 'Llama'];
---

<section class="hero">
  <HeroDots />
  <div class="container hero-inner">
    <h1>Semua model AI.<br /><span class="accent">Satu API.</span></h1>
    <p class="hero-sub">
      Satu API key untuk akses model frontier dengan routing otomatis dan harga transparan.
    </p>
    <p class="hero-typed">
      <span class="muted">Akses</span>&nbsp;<Typewriter phrases={phrases} />&nbsp;<span class="muted">dan puluhan model lain — lewat endpoint yang sama.</span>
    </p>
    <div class="hero-cta">
      <Button href="/register" variant="primary" size="lg">Mulai gratis</Button>
      <Button href="/models" variant="ghost" size="lg">Lihat model</Button>
    </div>
  </div>
</section>

<style>
  /* min-height menahan tinggi baris supaya mengetik/menghapus tidak menggeser
     tombol CTA di bawahnya. */
  .hero-typed {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.35ch;
    min-height: 28px;
    margin: 0 auto var(--sb-xl);
    font-size: var(--sb-body-md);
  }
</style>
