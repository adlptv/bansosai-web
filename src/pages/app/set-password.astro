---
// /app/set-password — Google-only accounts set a first password.
// Ported from the pre-rebuild compiled page (server-rendered form + flashes).
import AppShell from '../../layouts/AppShell.astro';
import Flash from '../../components/Flash.astro';
import { getSessionUser } from '../../lib/api/session';

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect('/login');
if (user.hasPassword) return Astro.redirect('/app');

const err = Astro.url.searchParams.get('err');
const msg = Astro.url.searchParams.get('msg');
const provider = 'Google';
---

<AppShell title="Set Password" user={user}>
  <section class="section">
    <div class="container" style="max-width:460px">
      <div class="card">
        <h3 style="margin-bottom:6px">Lengkapi Akun — buat password</h3>
        <p class="muted" style="font-size:13px;margin-bottom:14px">
          Akun <b>{provider}</b> ini belum punya password. Buat satu sekarang agar kamu bisa login
          dengan email/password dan melindungi akun.
        </p>
        {err && <Flash kind="err" message={err} />}
        {msg && <Flash kind="ok" message={msg} />}
        <form method="POST" action="/api/set-password">
          <label class="label" for="newPassword">Password Baru</label>
          <input
            class="input"
            id="newPassword"
            type="password"
            name="newPassword"
            required
            minlength="8"
            autocomplete="new-password"
          />
          <p class="muted" style="font-size:12px;margin-top:4px">Min 8 karakter, kombinasi huruf dan angka.</p>
          <div class="form-actions"><button class="btn btn-primary" type="submit" style="flex:1">Simpan &amp; Lanjut</button></div>
        </form>
      </div>
    </div>
  </section>
</AppShell>
