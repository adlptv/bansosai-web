---
// /admin — admin overview: revenue, traffic, users, health, recent sales.
//
// Gated server-side (lib/api/admin.ts); the client script then calls
// /api/console/* with the console JWT as a Bearer token.
import AppShell from '../../layouts/AppShell.astro';
import { requireAdminPage } from '../../lib/api/admin';
import '../../styles/admin.css';

const gate = await requireAdminPage(Astro);
if (gate) return gate;
---

<AppShell title="Overview">
  <h1 style="margin-bottom:8px;">Dashboard Admin</h1>
  <p class="muted" style="margin-bottom:24px;">
    Pendapatan, trafik, pengguna, dan kesehatan sistem.
  </p>

  <div id="admin-content">
    <div id="load-err"></div>

    <h2 class="section-title">Pendapatan</h2>
    <div class="stats-grid" style="margin-bottom:8px;">
      <div class="stat-card stat-card-accent">
        <div class="stat-value" id="rev-today">—</div>
        <div class="stat-label">Hari Ini</div>
      </div>
      <div class="stat-card stat-card-accent">
        <div class="stat-value" id="rev-week">—</div>
        <div class="stat-label">Minggu Ini</div>
      </div>
      <div class="stat-card stat-card-accent">
        <div class="stat-value" id="rev-month">—</div>
        <div class="stat-label">Bulan Ini</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="rev-all">—</div>
        <div class="stat-label">Total (all-time)</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="rev-count">—</div>
        <div class="stat-label">Transaksi Hari Ini</div>
      </div>
    </div>

    <h2 class="section-title">Trafik &amp; Pengguna</h2>
    <div class="stats-grid" style="margin-bottom:8px;">
      <div class="stat-card">
        <div class="stat-value" id="stat-users">—</div>
        <div class="stat-label">Total Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-active">—</div>
        <div class="stat-label">Active Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-keys">—</div>
        <div class="stat-label">API Keys</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-requests-today">—</div>
        <div class="stat-label">Request Hari Ini</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-tokens-today">—</div>
        <div class="stat-label">Tokens Hari Ini</div>
      </div>
      <div class="stat-card">
        <div class="stat-value" id="stat-tokens-month">—</div>
        <div class="stat-label">Tokens Bulan Ini</div>
      </div>
    </div>

    <div data-last-updated style="font-size:12px;color:var(--sb-ink-faint);margin-bottom:24px;"></div>

    <div class="dash-grid" style="margin-bottom:24px;">
      <div class="card">
        <h3 style="margin-bottom:16px;">Trafik 24 Jam</h3>
        <div id="traffic-chart"><p class="muted">Memuat...</p></div>
      </div>
      <div class="card">
        <h3 style="margin-bottom:16px;">System Health</h3>
        <div id="health-status"><p class="muted">Memuat...</p></div>
      </div>
    </div>

    <div class="dash-grid" style="margin-bottom:24px;">
      <div class="card">
        <h3 style="margin-bottom:16px;">Penjualan Terbaru</h3>
        <div id="recent-sales"><p class="muted">Memuat...</p></div>
      </div>
      <div class="card">
        <h3 style="margin-bottom:16px;">Pengguna Terbaru</h3>
        <div id="recent-users"><p class="muted">Memuat...</p></div>
      </div>
    </div>

    <div class="card">
      <h3 style="margin-bottom:16px;">Kelola</h3>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/admin/users" class="btn">Users</a>
        <a href="/admin/plans" class="btn">Plans &amp; Harga</a>
        <a href="/admin/models" class="btn">Models</a>
        <a href="/admin/providers" class="btn">Providers</a>
        <a href="/admin/usage" class="btn">Usage</a>
        <a href="/admin/promos" class="btn">Promos</a>
        <a href="/admin/combos" class="btn">Combos</a>
        <a href="/admin/settings" class="btn">Settings</a>
      </div>
    </div>
  </div>
</AppShell>

<script is:inline src="/js/admin-session.js"></script>
<script is:inline>
  let token = window.adminSession.get();
  let statsPoller = null;

  // The page is gated server-side: reaching this script means the gateway
  // already verified the console token. The client only needs the token to
  // authorize its own /api/console/* calls.
  showContent();

  function showContent() {
    loadHealth();
    loadTraffic();
    loadRevenue();
    if (statsPoller) clearInterval(statsPoller);
    const tick = async () => {
      try {
        const resp = await fetch('/api/console/saas/stats', {
          headers: { authorization: 'Bearer ' + token },
        });
        if (resp.status === 401) return logout();
        if (!resp.ok) return;
        renderStats(await resp.json());
        const el = document.querySelector('[data-last-updated]');
        if (el) el.textContent = 'Terakhir diperbarui: ' + new Date().toLocaleTimeString('id-ID');
      } catch (e) { /* keep polling */ }
    };
    tick();
    statsPoller = setInterval(tick, 30000);
  }

  async function loadRevenue() {
    try {
      const resp = await fetch('/api/console/saas/revenue', {
        headers: { authorization: 'Bearer ' + token },
      });
      if (resp.status === 401) return logout();
      if (!resp.ok) return;
      renderRevenue(await resp.json());
    } catch (e) { /* leave placeholders */ }
  }

  function renderRevenue(d) {
    setText('rev-today', rupiah(d.todayIdr));
    setText('rev-week', rupiah(d.weekIdr));
    setText('rev-month', rupiah(d.monthIdr));
    setText('rev-all', rupiah(d.allTimeIdr));
    setText('rev-count', formatNum(d.todayCount));
    const rows = d.recent || [];
    const el = document.getElementById('recent-sales');
    if (!el) return;
    if (rows.length === 0) { el.innerHTML = '<p class="muted">Belum ada penjualan.</p>'; return; }
    el.innerHTML = rows.slice(0, 8).map(s => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--sb-hairline);">
        <div style="min-width:0;">
          <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${s.email || '—'}</div>
          <div class="muted" style="font-size:12px;">${s.planCode || '—'} · ${s.period || ''} · ${s.paidAt ? new Date(s.paidAt).toLocaleString('id-ID') : ''}</div>
        </div>
        <span class="badge badge-green">${rupiah(s.amountIdr)}</span>
      </div>
    `).join('');
  }

  async function loadTraffic() {
    try {
      const resp = await fetch('/api/console/usage/chart?period=24h', {
        headers: { authorization: 'Bearer ' + token },
      });
      if (resp.status === 401) return logout();
      if (!resp.ok) return;
      renderTraffic(await resp.json());
    } catch (e) { /* leave placeholder */ }
  }

  function renderTraffic(d) {
    const el = document.getElementById('traffic-chart');
    if (!el) return;
    // Accept either {points:[{label,requests}]} or an array of rows.
    const pts = Array.isArray(d) ? d : (d.points || d.series || d.buckets || []);
    const values = pts.map(p => Number(p.requests ?? p.count ?? p.value ?? 0));
    if (values.length === 0) { el.innerHTML = '<p class="muted">Belum ada data trafik.</p>'; return; }
    const max = Math.max(1, ...values);
    const total = values.reduce((a, b) => a + b, 0);
    el.innerHTML = `
      <div style="display:flex;align-items:flex-end;gap:3px;height:120px;">
        ${values.map(v => `<div title="${formatNum(v)} req" style="flex:1;min-width:3px;height:${Math.max(2, Math.round((v / max) * 100))}%;background:var(--sb-primary);border-radius:2px;"></div>`).join('')}
      </div>
      <p class="muted" style="margin-top:8px;font-size:12px;">Total ${formatNum(total)} request dalam 24 jam terakhir.</p>
    `;
  }

  function renderStats(data) {
    setText('stat-users', formatNum(data.totalUsers ?? data.total_users));
    setText('stat-active', formatNum(data.activeUsers ?? data.active_users));
    setText('stat-keys', formatNum(data.totalKeys ?? data.total_keys));
    setText('stat-tokens-today', formatNum(data.tokensToday ?? data.tokens_today));
    setText('stat-tokens-month', formatNum(data.tokensMonth ?? data.tokens_month));
    setText('stat-requests-today', formatNum(data.requestsToday ?? data.requests_today));

    const recent = data.recentUsers ?? data.recent_users ?? [];
    const recentEl = document.getElementById('recent-users');
    if (!recentEl) return;
    if (recent.length === 0) {
      recentEl.innerHTML = '<p class="muted">Belum ada pengguna.</p>';
    } else {
      recentEl.innerHTML = recent.slice(0, 5).map(u => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--sb-hairline);">
          <div style="min-width:0;">
            <div style="font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${u.email}</div>
            <div class="muted" style="font-size:12px;">${u.plan || 'free'} &middot; ${new Date(u.createdAt ?? u.created_at).toLocaleDateString('id-ID')}</div>
          </div>
          <span class="badge ${u.status === 'active' ? 'badge-green' : 'badge-orange'}">${u.status || 'active'}</span>
        </div>
      `).join('');
    }
  }

  function setText(id, v) {
    const el = document.getElementById(id);
    if (el) el.textContent = v;
  }

  function rupiah(n) {
    if (n === undefined || n === null) return '—';
    return 'Rp ' + Number(n).toLocaleString('id-ID');
  }

  function formatNum(n) {
    if (n === undefined || n === null) return '—';
    if (n >= 1_000_000_000) return (n / 1_000_000_000).toFixed(2) + 'B';
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
    if (n >= 1_000) return (n / 1_000).toFixed(1) + 'K';
    return String(n);
  }

  async function loadHealth() {
    try {
      const resp = await fetch('/api/console/health/metrics', {
        headers: { authorization: 'Bearer ' + token },
      });
      if (resp.status === 401) return logout();
      const data = await resp.json();

      const uptime = data.uptime ? formatUptime(data.uptime) : '—';
      const mem = data.memory_mb ?? data.memoryMB ?? '—';
      const goroutines = data.goroutines ?? '—';

      document.getElementById('health-status').innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <span class="badge badge-green">Healthy</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:14px;">
          <div><span class="muted">Uptime:</span><br/>${uptime}</div>
          <div><span class="muted">Memory:</span><br/>${mem} MB</div>
          <div><span class="muted">Goroutines:</span><br/>${goroutines}</div>
          <div><span class="muted">Version:</span><br/>${data.version || '—'}</div>
        </div>
      `;
    } catch (e) {
      document.getElementById('health-status').innerHTML = `
        <div style="display:flex;align-items:center;gap:8px;">
          <span class="badge badge-red">Unhealthy</span>
          <span class="muted">${e.message}</span>
        </div>
      `;
    }
  }

  function formatUptime(seconds) {
    if (typeof seconds === 'string') return seconds;
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    if (h > 24) return Math.floor(h / 24) + 'd ' + (h % 24) + 'h';
    return h + 'h ' + m + 'm';
  }

  function logout() {
    window.adminSession.clear();
    token = '';
    window.location.href = '/login?err=' + encodeURIComponent('Sesi admin berakhir, login ulang.');
  }
</script>
