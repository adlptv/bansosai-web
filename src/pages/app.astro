---
// /app — post-login landing for the public site.
//
// The full user dashboard lives in the console (/console/); this page confirms
// the session and shows a short account summary with a link into the console.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { getApi, SESSION_COOKIE } from '../lib/api/server';
import { redirectWith } from '../lib/api/auth';
import { formatNumber, formatWib, quotaLabel } from '../lib/format';
import type { DashboardResponse } from '../lib/api/client';

const token = Astro.cookies.get(SESSION_COOKIE)?.value;
if (!token) {
  return redirectWith('/login');
}

let dashboard: DashboardResponse | null = null;
let loadFailed = false;
try {
  dashboard = await getApi().getDashboard(token);
} catch {
  loadFailed = true;
}

if (loadFailed) {
  // An invalid/expired session cookie should not strand the visitor here.
  return redirectWith('/login', ['bns_session=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0']);
}

const user = dashboard?.user;
const plan = dashboard?.plan;
const quota = dashboard?.quota;
---

<Base
  title="Akun Saya"
  description="Ringkasan akun bansosAI: plan aktif, kuota, dan akses ke console."
  canonical="/app"
  noindex
>
  <main>
    <section class="section">
      <div class="container container-narrow">
        <header class="page-header">
          <h1>Login berhasil</h1>
          <p>Kamu masuk sebagai <b>{user?.email}</b>.</p>
        </header>

        <div class="stat-row" style="margin-bottom:var(--sb-xl)">
          <div class="stat">
            <div class="stat-value">{plan?.name ?? 'Free'}</div>
            <div class="stat-label">Plan aktif</div>
          </div>
          <div class="stat">
            <div class="stat-value">
              {quota?.total ? `${formatNumber(quota.used)} / ${formatNumber(quota.total)}` : formatNumber(quota?.used ?? 0)}
            </div>
            <div class="stat-label">{quota?.total ? 'Token terpakai' : 'Token terpakai (unlimited)'}</div>
          </div>
          <div class="stat">
            <div class="stat-value">{formatNumber(dashboard?.activeKeys ?? 0)}</div>
            <div class="stat-label">API key aktif</div>
          </div>
        </div>

        <div class="card" style="padding:var(--sb-lg);margin-bottom:var(--sb-xl)">
          <h2 style="font-size:var(--sb-heading-md)">Ringkasan</h2>
          <dl class="model-specs" style="font-size:var(--sb-body-md)">
            <dt>Kuota plan</dt><dd>{plan ? quotaLabel(plan.tokenQuota) : '—'}</dd>
            <dt>Batas RPM</dt><dd>{plan?.rpmLimit ?? '—'}</dd>
            <dt>Aktif sampai</dt><dd>{dashboard?.subscription ? formatWib(dashboard.subscription.expiresAtWib) : '—'}</dd>
            <dt>Status akun</dt><dd>{user?.status ?? '—'}</dd>
          </dl>
        </div>

        <div style="display:flex;gap:var(--sb-md);flex-wrap:wrap">
          <Button href="/console/" variant="primary">Buka Console</Button>
          <Button href="/models" variant="ghost">Jelajahi model</Button>
        </div>

        <p class="muted small" style="margin-top:var(--sb-xl)">
          Dashboard user lengkap ada di console. Di sana kamu bisa membuat dan mencabut API key,
          memantau pemakaian, serta mengatur kuota.
        </p>
      </div>
    </section>
  </main>
</Base>
