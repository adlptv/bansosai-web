# Build inputs — every rebuild must keep these in sync
node_modules/
dist/
.astro/

# Local environment: service config is supplied by the host, never committed
.env
.env.*
!.env.example

# Local OS/editor noise
.DS_Store
Thumbs.db
*.log

# Release artifacts are produced by the deploy step, not stored in the tree
*.tar.gz
*.tgz
