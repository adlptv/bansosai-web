# Example service configuration for the rebuilt web tier.
#
# Copy to .env and fill from the host's protected service configuration.
# NEVER commit real values, and never log them.
#
# Names only are listed here deliberately: the plan forbids recording credential
# values, and the authoritative source for what each variable means is
# docs/INFRASTRUCTURE.md plus the deployed unit file.

# --- runtime ---
# Public hostname this app serves.
SAAS_WEB_URL=

# Authoritative API base. Production SaaS reads/writes must reach the API tier,
# never a local gateway or a local database.
API_INTERNAL_URL=

# Database access is intentionally ABSENT: the web tier must not hold database
# credentials. If a value like DB_PATH appears in this project, that is a bug.

# --- optional integrations ---
# Names only; presence and shape are documented in the deployment notes.
SAAS_OAUTH_ENABLED_PROVIDERS=
